# Same-origin proxy bases (see next.config.ts rewrites → inventory :8012, auth :8002, telemetry :8013, reporting :8014)
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:3003/api/inventory
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3003/api/auth
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:3003/api/telemetry/events
NEXT_PUBLIC_REPORTING_API_URL=http://localhost:3003/api/reporting

# Server-side rewrite targets (optional; default to localhost backends for native dev; overridden in Docker compose)
# INVENTORY_API_ORIGIN=http://localhost:8012
# AUTH_API_ORIGIN=http://localhost:8002
# TELEMETRY_API_ORIGIN=http://localhost:8013
# REPORTING_API_ORIGIN=http://localhost:8014
