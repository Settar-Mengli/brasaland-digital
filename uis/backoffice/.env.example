# Same-origin proxy bases (see next.config.ts rewrites → inventory :8012, auth :8002, telemetry :8013, reporting :8014)
# Docker Compose + Caddy: use http://localhost/staff/api/* (see docker-compose.yml ui service).
# Native dev on :3003 without Caddy: use http://localhost:3003/api/* below.
# Unset NEXT_PUBLIC_* to default under basePath /staff/api/* (see lib/staff-paths.ts).
NEXT_PUBLIC_STAFF_BASE_PATH=/staff
NEXT_PUBLIC_INVENTORY_API_URL=/staff/api/inventory
NEXT_PUBLIC_AUTH_API_URL=/staff/api/auth
NEXT_PUBLIC_TELEMETRY_ENDPOINT=/staff/api/telemetry/events
NEXT_PUBLIC_REPORTING_API_URL=/staff/api/reporting
NEXT_PUBLIC_KNOWLEDGE_API_URL=/staff/api/knowledge
NEXT_PUBLIC_RFP_API_URL=/staff/api/rfp
# NEXT_PUBLIC_SLICE_NAV=1  # production slice image only: hide inventory/reporting/knowledge nav

# Server-side rewrite targets (optional; default to localhost backends for native dev; overridden in Docker compose)
# INVENTORY_API_ORIGIN=http://localhost:8012
# AUTH_API_ORIGIN=http://localhost:8002
# TELEMETRY_API_ORIGIN=http://localhost:8013
# REPORTING_API_ORIGIN=http://localhost:8014
# KNOWLEDGE_API_ORIGIN=http://localhost:8015
# RFP_API_ORIGIN=http://localhost:8017
