# Server-only — website BFF Route Handler (POST /api/chat)
AUTH_API_ORIGIN=http://localhost:8002
PUBLIC_KNOWLEDGE_API_ORIGIN=http://localhost:8015
WEBSITE_KNOWLEDGE_CLIENT_ID=
WEBSITE_KNOWLEDGE_CLIENT_SECRET=

# Turnstile (optional; disabled by default for local demo)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare dummy test keys (local verification only — replace with real keys at deploy)
# Always pass: site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
# Always fail: site 2x00000000000000000000AB  secret 2x0000000000000000000000000000000AA

# Client-visible — guest chat widget
NEXT_PUBLIC_PUBLIC_CHAT_ENABLED=false
