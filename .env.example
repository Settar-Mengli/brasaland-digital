# Root environment template for Docker Compose variable interpolation.
# Copy to .env and fill real values: cp .env.example .env
# Root .gitignore ignores .env — never commit secrets.
#
# For native (non-Docker) dev, services still load per-service files such as
# services/auth/.env and services/inventory/.env via python-dotenv.
# This root .env is injected into containers by docker-compose.yml.

# Shared Supabase PostgreSQL (inventory + incident-manager).
# Use the Transaction pooler URI (port 6543). Prefer a password with letters and
# numbers only to avoid URL-encoding issues.
DATABASE_URL=postgresql://user:pass@host:6543/postgres

# Alembic + operator DDL (direct session, port 5432). Table owner bypasses RLS.
MIGRATION_DATABASE_URL=postgresql://postgres:pass@host:5432/postgres

# Per-service runtime roles (pooler 6543). Fall back to DATABASE_URL when unset.
INVENTORY_DATABASE_URL=postgresql://brasaland_inventory:pass@host:6543/postgres
TELEMETRY_DATABASE_URL=postgresql://brasaland_telemetry:pass@host:6543/postgres
INCIDENT_DATABASE_URL=postgresql://brasaland_incident:pass@host:6543/postgres
RFP_DATABASE_URL=postgresql://brasaland_rfp:pass@host:6543/postgres
REPORTING_DATABASE_URL=postgresql://brasaland_reporting:pass@host:6543/postgres

# Disposable Postgres CI / apply_db_roles_rls.py (not for production).
# BRASALAND_RUNTIME_ROLE_PASSWORD=ci_brasaland_runtime_role_password

# Celery broker + result backend (reporting API, worker, Flower).
# Host/native: redis://localhost:6379/0
# Inside Compose containers: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# LangGraph RFP checkpointer (SQLite on the rfp_checkpoint Docker volume).
# Inside Compose both rfp and rfp-worker mount that volume at /app/checkpoint.
# RFP_CHECKPOINT_PATH=/app/checkpoint/rfp.sqlite

# RS256 JWT keys — PEM with escaped newlines inside double quotes.
# auth signs with JWT_PRIVATE_KEY; inventory verifies with JWT_PUBLIC_KEY.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key-pem\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-your-public-key-pem\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256

# Publish /docs + /openapi.json on FastAPI services when set to 1/true.
# Default unset = docs disabled (compose passes EXPOSE_DOCS through).
# EXPOSE_DOCS=1

# Optional SlowAPI buckets (in-memory; Redis-backed storage is the scale-up path).
# RATE_LIMIT_AUTH=5/minute
# RATE_LIMIT_RFP_UPLOAD=10/minute
# RATE_LIMIT_ANALYZE=10/minute
# RATE_LIMIT_REPORTING_ENQUEUE=10/minute
# RATE_LIMIT_TELEMETRY_INGEST=60/minute
# RATE_LIMIT_AGENT_QUERY=10/minute
# RATE_LIMIT_KNOWLEDGE_QUERY=20/minute

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=30

RESEND_API_KEY=replace-with-your-resend-api-key
RESET_EMAIL_FROM=onboarding@resend.dev

# Browser-reachable auth URL for password-reset email links (host-published port).
# Do NOT set this to a Docker service name (e.g. http://auth:8002).
RESET_LINK_BASE_URL=http://127.0.0.1:8002

# Auth access policy: self-registration gate (default off) and first-admin
# bootstrap (seeded on startup only when the auth user store is empty).
AUTH_ALLOW_SELF_REGISTER=false
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# Knowledge / RAG (services/knowledge + Qdrant). Operator fills real values in .env.
QDRANT_URL=http://localhost:6333
KNOWLEDGE_CORPUS_PATH=
EMBED_MODEL_ID=BAAI/bge-small-en-v1.5
# ── Generation providers (priority failover: GEN_1 → GEN_2 → … → GEN_N) ──
# Discovery walks N=1,2,… while GEN_N_API_KEY is set (blank key skips that tier)
# and stops at the first N where GEN_N_API_KEY is entirely absent (a gap ends the
# scan — later tiers are not tried). Fill at least one key. Base URLs are public;
# models are current free-tier defaults — verify the exact model ID in each
# provider's console before relying on it.
# Tier 1 — Groq (OpenAI-compatible)
# llama-3.3-70b-versatile was decommissioned 2026-08-16 (free/developer).
# Replacement: openai/gpt-oss-120b (alt: qwen/qwen3.6-27b).
# https://console.groq.com/docs/deprecations
GEN_1_BASE_URL=https://api.groq.com/openai/v1
GEN_1_API_KEY=
GEN_1_MODEL=openai/gpt-oss-120b
# Tier 2 — Cerebras (OpenAI-compatible; free tier caps context at 8K tokens)
GEN_2_BASE_URL=https://api.cerebras.ai/v1
GEN_2_API_KEY=
GEN_2_MODEL=llama-3.3-70b
# Tier 3 — Google Gemini (OpenAI-compatible; trailing slash required).
# Gemini 3.x flash-lite may now be current — confirm the ID in AI Studio.
GEN_3_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEN_3_API_KEY=
GEN_3_MODEL=gemini-2.5-flash-lite
# Tier 4 — Mistral (OpenAI-compatible); optional — leave key blank to skip.
GEN_4_BASE_URL=https://api.mistral.ai/v1
GEN_4_API_KEY=
GEN_4_MODEL=mistral-small-latest
# Optional per-attempt generation timeout in seconds (default 30)
# GENERATION_TIMEOUT_SECONDS=30
# Knowledge agent → company-tools MCP (native default; compose uses http://company-tools-mcp:8016/mcp).
MCP_SERVER_URL=http://localhost:8016/mcp
# Upstream origins used by the MCP server (not by knowledge directly).
INCIDENTS_API_ORIGIN=http://localhost:8011
INVENTORY_API_ORIGIN=http://localhost:8012
AUTH_ISSUER_URL=http://localhost:8002
MCP_RESOURCE_URL=http://localhost:8016/mcp
# Comma-separated user_id values granted tickets:write at the MCP resource server.
MCP_TICKETS_WRITE_ALLOWLIST=
# Dedicated non-admin access JWT used only for MCP-to-service requests. Provision
# out of band with all 14 authorized_locations; rotate before expiry. Never commit it.
MCP_SERVICE_TOKEN=

# ── RFP slice (docker-compose.slice.yml) ──
# Public hostname Caddy uses for TLS. Local smoke: localhost (HTTP :80).
# SLICE_HOST=rfp.example.com
# Password reset is OFF on this slice (Caddy does not route /reset-password).
# If you later enable reset, RESET_LINK_BASE_URL must be https://$SLICE_HOST
# (auth serves GET /reset-password, not /api/auth/reset-password).
# Production backoffice image bakes NEXT_PUBLIC_SLICE_NAV=1
# (uis/backoffice/Dockerfile). Do not set NEXT_PUBLIC_AUTH_API_URL /
# NEXT_PUBLIC_RFP_API_URL in that image — browser calls relative /api/auth and /api/rfp.
# Inside this compose network REDIS_URL is overridden to redis://redis:6379/0.
