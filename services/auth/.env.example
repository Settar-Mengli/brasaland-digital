# Generate a real keypair (do NOT commit real keys):
#   openssl genpkey -algorithm RSA -pkcs8 -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
replace-with-your-private-key-pem
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
replace-with-your-public-key-pem
-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=RS256
RESET_TOKEN_EXPIRE_MINUTES=30
RESEND_API_KEY=replace-with-your-resend-api-key
RESET_EMAIL_FROM=onboarding@resend.dev
RESET_LINK_BASE_URL=http://127.0.0.1:8002
# Self-registration gate: POST /auth/register returns 403 unless set to true.
AUTH_ALLOW_SELF_REGISTER=false
# First-admin bootstrap: seeded on startup only when the user store is empty
# (both values required; leave blank to disable).
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# Trusted proxy CIDRs for SlowAPI client IP (comma-separated). Unset locally.
# TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8
