# Copy repo-root .env.example for shared JWT / GEN / Qdrant values.
# This file lists knowledge-service overrides for the public guest route.

# Enable POST /public/knowledge/query (website BFF only; fail closed when unset).
PUBLIC_KNOWLEDGE_ENABLED=false

# Optional public corpus path (Compose mounts docs/public-knowledge-base).
# PUBLIC_KNOWLEDGE_CORPUS_PATH=

# SlowAPI bucket for public guest queries (default 5/minute).
# RATE_LIMIT_PUBLIC_KNOWLEDGE_QUERY=5/minute

# Expected svc claim on Bearer tokens from auth service-token grant.
# WEBSITE_KNOWLEDGE_SVC_CLAIM=website-knowledge

# Deferred production caps (stub when PUBLIC_DAILY_CAPS_ENABLED=false).
# PUBLIC_DAILY_CAPS_ENABLED=false

# Optional isolated generation tiers for public answers (else shared GEN_*).
# GEN_PUBLIC_1_BASE_URL=
# GEN_PUBLIC_1_API_KEY=
# GEN_PUBLIC_1_MODEL=
